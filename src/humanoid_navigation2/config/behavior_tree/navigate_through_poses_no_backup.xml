<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <!--
      路线任务 through 专用行为树。

      这个文件专门给 NavigateThroughPoses 使用，必须读取 {goals}，不能复用
      单点导航行为树。route task 的 transit 点需要通过 RemovePassedGoals +
      ComputePathThroughPoses 连续跟随，避免到每个 transit 都停车、对齐、播报。

      这里取消 BT 自己的 RecoveryNode / Wait / Spin / ClearCostmap 恢复动作。
      FollowPath 或规划失败时直接返回给 humanoid_route_runtime 的
      navigation_state_manager_cpp，由状态机统一进入动态障碍等待、APP 周期提示和自动恢复。
    -->

    <PipelineSequence name="NavigateThroughWithReplanning">
      <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
      <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>

      <RateController hz="0.333">
        <ReactiveSequence>
          <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"/>
          <ComputePathThroughPoses goals="{goals}"
                                   path="{path}"
                                   planner_id="{selected_planner}"
                                   error_code_id="{compute_path_error_code}"/>
        </ReactiveSequence>
      </RateController>

      <FollowPath path="{path}"
                  controller_id="{selected_controller}"
                  goal_checker_id="xy_goal_checker"
                  error_code_id="{follow_path_error_code}"/>
    </PipelineSequence>

  </BehaviorTree>
</root>
